
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function getRole() {
      // Assumes user role is stored in a top-level `users` collection.
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }
    function isAdmin() {
      // Defines what roles are considered administrative.
      return signedIn() && getRole() in ['Admin', 'CEO', 'Accounts Manager'];
    }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }

    // ---------- PUBLIC (Landing Page) ----------
    match /locations/{id} { allow read: if true; }
    match /jobOpenings/{id} { allow read: if true; }
    match /shopProducts/{id} { allow read: if true; }
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /posts/{id} { allow read: if true; allow write: if isAdmin(); }
    match /offers/{id} { allow read: if true; allow write: if isAdmin(); }
    match /company/{id} { allow read: if true; allow write: if isAdmin(); }
    match /pickupPoints/{id} { allow read: if true; }

    // ---------- USERS ----------
    match /users/{userId} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update, delete: if isOwner(userId) || isAdmin();

      match /notifications/{id} {
        allow read, write: if isOwner(userId);
      }
      match /wallet/main { allow read, write: if isOwner(userId) || isAdmin(); }
      match /referrals/{id} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /registeredProducts/{id} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /stock/{productId} { allow read, write: if isOwner(userId) || isAdmin(); }
    }

    // ---------- ORDERS ----------
    match /orders/{orderId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.assignedToUid == request.auth.uid
      );

      allow create: if signedIn() && (
        isAdmin() ||
        request.resource.data.userId == request.auth.uid
      );

      allow update: if signedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.assignedToUid == request.auth.uid
      );

      allow delete: if isAdmin();
    }

    // ---------- SALES INVOICES ----------
    match /salesInvoices/{invoiceId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.customerId == request.auth.uid ||
        resource.data.assignedToUid == request.auth.uid
      );
      allow create, update: if signedIn() && (isAdmin() || getRole() == 'Partner');
      allow delete: if isAdmin();
    }
    
    // ---------- OTHER COLLECTIONS ----------
    match /leads/{id} { allow read, write: if signedIn(); }
    match /quotations/{id} { allow read, write: if signedIn(); }
    match /serviceRequests/{id} { allow read, write: if signedIn(); }
    match /purchaseRequests/{id} { allow read, write: if signedIn(); }
    match /purchaseOrders/{id} { allow read, write: if signedIn(); }
    match /grns/{id} { allow read, write: if signedIn(); }
    match /boms/{id} { allow read, write: if signedIn(); }
    match /workOrders/{id} { allow read, write: if signedIn(); }
    match /tasks/{id} { allow read, write: if signedIn(); }
    match /goals/{goalId}/{document=**} { allow read, write: if signedIn(); }
    match /reimbursementRequests/{id} { allow read, write: if signedIn(); }
    match /salaryAdvanceRequests/{id} { allow read, write: if signedIn(); }
    match /onboarding/{id} { allow read, write: if signedIn(); }
    match /offboarding/{id} { allow read, write: if signedIn(); }
    match /payoutRequests/{id} { allow read, write: if signedIn(); }
    match /paymentSubmissions/{id} { allow read, write: if signedIn(); }
    match /stockTransferRequests/{id} { allow read, write: if signedIn(); }
    match /productCategories/{id} { allow read, write: if signedIn(); }
    match /counters/{id} { allow read, write: if signedIn(); }


    // ---------- ACCOUNTING (Strict) ----------
    match /coa_ledgers/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /coa_groups/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /journalVouchers/{id} { allow read, write: if isAdmin(); }
    match /parties/{id} { allow read, write: if signedIn(); }

    match /report_cache/{monthId} { allow read: if isAdmin(); allow write: if false; }
    match /fy_openings/{fyId} { allow read: if isAdmin(); allow write: if false; }

    // ---------- FINAL SAFETY NET ----------
    match /{path=**} {
      allow read, write: if isAdmin();
    }
  }
}
