
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- 1. GLOBAL HELPERS ---
    function signedIn() { return request.auth != null; }
    function getRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() { return signedIn() && getRole() in ['Admin', 'CEO', 'Sales Manager', 'Accounts Manager', 'Accountant']; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }

    // --- 2. USERS & ACCOUNT DATA ---
    match /users/{userId} {
      allow get: if signedIn(); 
      allow list: if isAdmin();
      allow write: if isOwner(userId) || isAdmin();
      
      match /notifications/{id} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /wallet/main { allow read, write: if isOwner(userId) || isAdmin(); }
      match /referrals/{id} { allow read, write: if isOwner(userId) || isAdmin(); }
      
      // Fix for "My Products" KPI
      match /registeredProducts/{id} { 
        allow read, list: if isOwner(userId) || isAdmin(); 
      }
    }

    // --- 3. ACCOUNTING ---
    match /journalVouchers/{id} { 
      allow read, list: if signedIn(); 
      allow write: if isAdmin();
    }
    
    match /coa_ledgers/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /coa_groups/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /parties/{id} { allow read: if signedIn(); allow write: if isAdmin(); }

    // --- 4. LOGISTICS ---
    match /orders/{orderId} {
      allow get, list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid || resource.data.assignedToUid == request.auth.uid);
      allow create: if signedIn();
      allow update: if isAdmin() || (signedIn() && (resource.data.userId == request.auth.uid || resource.data.assignedToUid == request.auth.uid));
    }

    match /salesInvoices/{invoiceId} {
      allow get, list: if signedIn() && (isAdmin() || resource.data.customerId == request.auth.uid || resource.data.assignedToUid == request.auth.uid);
      allow write: if isAdmin() || (signedIn() && request.resource.data.assignedToUid == request.auth.uid);
    }

    // --- 5. SALES & SERVICE ---
    match /leads/{id} {
      allow read, list: if signedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid);
      allow create: if signedIn();
      allow write: if signedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /serviceRequests/{id} {
      allow read, list: if signedIn(); 
      allow create: if signedIn();
      allow update: if isAdmin();
    }
    
    // Global registered products collection for admins
    match /registeredProducts/{id} {
       allow read, list: if signedIn() && (isAdmin() || resource.data.customerId == request.auth.uid || resource.data.ownerId == request.auth.uid);
    }

    // --- 6. PUBLIC CONTENT ---
    match /products/{id} {
      allow read, list: if true; 
      allow write: if isAdmin();
    }

    match /posts/{id} {
      allow read, list: if true; 
      allow write: if isAdmin();
    }

    match /offers/{id} {
      allow read, list: if true;
      allow write: if isAdmin();
    }
    
    match /vacancies/{id} {
        allow read, list: if true;
        allow write: if isAdmin();
    }

    // --- 7. HR (FIX for Reimbursement) ---
    match /reimbursementRequests/{id} {
        allow read, list: if isAdmin() || (signedIn() && request.query.where.createdByUid == request.auth.uid);
        allow create: if signedIn() && request.resource.data.createdByUid == request.auth.uid;
        allow update, delete: if isAdmin();
    }

    // --- 8. MISC SETTINGS & PAYMENTS ---
    match /pickupPoints/{id} { allow read, list: if true; allow write: if isAdmin(); }
    match /locations/{id} { allow read, list: if true; allow write: if isAdmin(); }
    match /company/{id} { allow read: if true; allow write: if isAdmin(); }
    
    match /paymentSubmissions/{id} {
      allow read, list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid || resource.data.assignedToUid == request.auth.uid);
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // --- 9. FINAL GLOBAL SAFETY NET ---
    match /{path=**} {
      allow read, write: if isAdmin();
    }
  }
}
