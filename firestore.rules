
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function getRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && getRole(request.auth.uid) in ['Admin', 'CEO', 'Accounts Manager'];
    }

    function isCompanyMember(companyId) {
        // In a single-company setup, we can assume membership if signed in,
        // or add more complex logic if needed later.
        return signedIn();
    }


    // =========================
    // PUBLIC-READABLE COLLECTIONS
    // =========================
    match /products/{productId} { allow read: if true; allow write: if isAdmin("default"); }
    match /vacancies/{vacancyId} { allow read: if true; allow write: if isAdmin("default"); }
    match /posts/{postId} { allow read: if true; allow write: if isAdmin("default"); }
    match /locations/{locationId} { allow read: if true; allow write: if isAdmin("default"); }
    match /pickupPoints/{pointId} { allow read: if true; allow write: if isAdmin("default"); }
    match /company/{docId} { allow read: if true; allow write: if isAdmin("default"); }
    match /offers/{offerId} { allow read: if signedIn(); allow write: if isAdmin(); }
    
    // =========================
    // USERS & USER-SPECIFIC DATA
    // =========================
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isAdmin();

      match /referrals/{referralId} {
        allow read, write: if isOwner(userId);
      }
      match /wallet/{walletId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin(); // Only functions should write here
      }
       match /registeredProducts/{productId} {
        allow read, write: if isOwner(userId);
      }
       match /stock/{stockId} {
        allow read, write: if isOwner(userId);
      }
    }
    
     // =========================
    // COMPANY-SCOPED DATA
    // =========================
    match /companies/{companyId} {
      allow read: if isCompanyMember(companyId);

      // --- Orders Subcollection ---
      match /orders/{orderId} {
        allow read: if isCompanyMember(companyId) && 
                       (isAdmin() || resource.data.userId == request.auth.uid || resource.data.assignedToUid == request.auth.uid);
        allow create: if isCompanyMember(companyId) && 
                         (request.resource.data.userId == request.auth.uid || isAdmin());
        allow update: if isCompanyMember(companyId) &&
                         (isAdmin() || resource.data.assignedToUid == request.auth.uid || resource.data.userId == request.auth.uid);
        allow delete: if isAdmin();
      }

      // Any other future subcollections under a company
      match /{allChildren=**} {
        allow read: if isCompanyMember(companyId);
        allow write: if isAdmin(companyId);
      }
    }


    // =========================
    // GLOBAL COLLECTIONS
    // =========================
    match /leads/{leadId} { allow read, write: if signedIn(); }
    match /quotations/{quotationId} { allow read, write: if signedIn(); }
    match /salesInvoices/{invoiceId} { allow read, write: if signedIn(); }
    match /creditNotes/{noteId} { allow read, write: if signedIn(); }
    match /debitNotes/{noteId} { allow read, write: if signedIn(); }
    match /purchaseRequests/{prId} { allow read, write: if signedIn(); }
    match /purchaseOrders/{poId} { allow read, write: if signedIn(); }
    match /grns/{grnId} { allow read, write: if signedIn(); }
    match /workOrders/{woId} { allow read, write: if signedIn(); }
    match /boms/{bomId} { allow read, write: if signedIn(); }
    match /tasks/{taskId} { allow read, write: if signedIn(); }
    match /serviceRequests/{srId} { allow read, write: if signedIn(); }
    match /reimbursementRequests/{rrId} { allow read, write: if signedIn(); }
    match /salaryAdvanceRequests/{arId} { allow read, write: if signedIn(); }
    match /payoutRequests/{prId} { allow read, write: if signedIn(); }
    match /paymentSubmissions/{psId} { allow read, write: if signedIn(); }
    match /stockTransferRequests/{strId} { allow read, write: if signedIn(); }
    
    // --- Accounting ---
    match /coa_groups/{groupId} { allow read, write: if isAdmin(); }
    match /coa_ledgers/{ledgerId} { allow read, write: if isAdmin(); }
    match /journalVouchers/{jvId} { allow read, write: if isAdmin(); }
    match /parties/{partyId} { allow read, write: if signedIn(); }
    match /counters/{counterId} { allow write: if signedIn(); }

    // --- System / Read-only ---
    match /report_cache/{monthId} { allow read: if isAdmin(); allow write: if false; }
    match /fy_openings/{fyId} { allow read: if isAdmin(); allow write: if false; }
  }
}
