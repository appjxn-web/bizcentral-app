
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- 1. GLOBAL HELPERS ---
    function signedIn() { return request.auth != null; }
    function getRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() { return signedIn() && getRole() in ['Admin', 'CEO', 'Sales Manager', 'Accounts Manager', 'Accountant']; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }

    // --- 2. USERS & SUB-COLLECTIONS ---
    match /users/{userId} {
      allow get: if signedIn(); 
      allow list: if isAdmin();
      allow write: if isOwner(userId) || isAdmin();
      
      match /notifications/{id} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /wallet/main { allow read, write: if isOwner(userId) || isAdmin(); }
      match /referrals/{id} { allow read, write: if isOwner(userId) || isAdmin(); }
      
      // FIXED: Customer must be able to see their own registered products
      match /registeredProducts/{id} { 
        allow read, list: if isOwner(userId) || isAdmin(); 
      }
    }

    // --- 3. ORDERS ---
    match /orders/{orderId} {
      allow get, list: if signedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid || 
        resource.data.assignedToUid == request.auth.uid
      );
      allow create: if signedIn();
      allow update: if isAdmin() || (signedIn() && (resource.data.userId == request.auth.uid || resource.data.assignedToUid == request.auth.uid));
    }

    // --- 4. SALES INVOICES ---
    match /salesInvoices/{invoiceId} {
        allow get, list: if signedIn() && (
          isAdmin() ||
          resource.data.customerId == request.auth.uid ||
          resource.data.assignedToUid == request.auth.uid
        );
        allow create, update: if signedIn() && (isAdmin() || request.resource.data.assignedToUid == request.auth.uid);
    }

    // --- 5. LEADS ---
    match /leads/{id} {
      allow read, list: if signedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid);
      allow create: if signedIn();
      allow write: if signedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    // --- 6. SERVICE & WARRANTY (New fixes for Customer Dashboard) ---
    match /serviceRequests/{id} {
      // Allow customers to see their own requests and admins to see all
      allow read, list: if signedIn() && (isAdmin() || resource.data.customer.id == request.auth.uid);
      allow create: if signedIn();
      allow update: if isAdmin();
    }
    
    match /registeredProducts/{id} {
       allow read, list: if signedIn() && (isAdmin() || resource.data.customerId == request.auth.uid);
    }

    // --- 7. PUBLIC CONTENT (Fixes 'posts' and 'offers' errors) ---
    match /posts/{id} {
      allow read, list: if true; // News/Posts are public
      allow write: if isAdmin();
    }

    match /offers/{id} {
      allow read, list: if signedIn(); // Signed in users can see active schemes
      allow write: if isAdmin();
    }

    // --- 8. ACCOUNTING (Ledgers, Groups, Vouchers) ---
    match /coa_ledgers/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /coa_groups/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /journalVouchers/{id} { allow read, list: if isAdmin(); } 
    match /parties/{id} { allow read: if signedIn(); allow write: if isAdmin(); }

    // --- 9. PAYMENT SUBMISSIONS ---
    match /paymentSubmissions/{id} {
      allow read, list: if signedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid || 
        resource.data.assignedToUid == request.auth.uid
      );
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // --- 10. SETTINGS ---
    match /pickupPoints/{id} { allow read, list: if true; allow write: if isAdmin(); }
    match /company/{id} { allow read: if true; allow write: if isAdmin(); }

    // --- FINAL GLOBAL SAFETY NET ---
    match /{path=**} {
      allow read, write: if isAdmin();
    }
  }
}
