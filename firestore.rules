
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function signedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // NEW: Check if user is a member of a specific company
    function isCompanyMember(companyId) {
      return signedIn() && getUserData().companyMemberships.exists(c, c.companyId == companyId);
    }

    // NEW: Get user's role within a specific company
    function getCompanyRole(companyId) {
      return getUserData().companyMemberships.filter(c, c.companyId == companyId)[0].role;
    }

    // NEW: Check if user has an admin-level role in a company
    function isCompanyAdmin(companyId) {
      return isCompanyMember(companyId) && getCompanyRole(companyId) in ['Admin', 'CEO', 'Accounts Manager'];
    }

    // Helper: allow only certain fields to change (field-level protection)
    function onlyChanges(allowed) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(allowed);
    }

    function isCreatingDraft() {
      return request.resource.data.status == "DRAFT";
    }

    function isDraftDoc() {
      return resource.data.status == "DRAFT";
    }

    // =========================
    // USERS
    // =========================
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin("default"));
      allow write: if false; // prevent client editing roles/companies
    }

    // =========================
    // COMPANY ROOT
    // =========================
    match /companies/{companyId} {
      allow read: if isCompanyMember(companyId);
      allow write: if isAdmin(companyId);

      // ---- Settings (Finance defaults etc.) ----
      match /settings/{docId} {
        allow read: if hasCompanyAccess(companyId);
        allow write: if isAdmin(companyId);
      }

      // ---- Masters ----
      match /customers/{customerId} {
        allow read: if hasCompanyAccess(companyId);
        allow create, update: if hasCompanyAccess(companyId);
        allow delete: if isAdmin(companyId);
      }

      match /products/{productId} {
        allow read: if hasCompanyAccess(companyId);
        allow write: if isAdmin(companyId);
      }

      match /warehouses/{warehouseId} {
        allow read: if hasCompanyAccess(companyId);
        allow write: if isAdmin(companyId);
      }

      match /coa_groups/{id} {
        allow read: if hasCompanyAccess(companyId);
        allow write: if isAdmin(companyId);
      }

      match /coa_ledgers/{id} {
        allow read: if hasCompanyAccess(companyId);
        allow write: if isAdmin(companyId);
      }

      // =========================
      // SALES INVOICES (CLIENT DRAFT OK)
      // =========================
      match /sales_invoices/{invoiceId} {
        allow read: if hasCompanyAccess(companyId);

        // ✅ Create only DRAFT from client
        allow create: if hasCompanyAccess(companyId)
          && isCreatingDraft()
          && request.resource.data.companyId == companyId
          && request.resource.data.createdBy == request.auth.uid;

        // ✅ Update: only allowed when invoice is still DRAFT
        // Client can change business fields, but NOT posting fields.
        allow update: if hasCompanyAccess(companyId)
          && isDraftDoc()
          && resource.data.createdBy == request.auth.uid
          && onlyChanges([
              // business editable fields
              "invoiceDate", "invoiceNo", "customerId", "warehouseId",
              "items", "discount", "shipping", "note",
              // safe metadata
              "updatedAt", "updatedBy",
              // allow status to remain DRAFT (no POSTED/POSTING from client)
              "status"
          ])
          && request.resource.data.status == "DRAFT";

        // ✅ Delete: allow deleting only DRAFT (optional)
        allow delete: if hasCompanyAccess(companyId)
          && isDraftDoc()
          && (resource.data.createdBy == request.auth.uid || isAdmin(companyId));
      }

      // =========================
      // SERVER-ONLY LEDGERS (POSTING OUTPUT)
      // =========================
      // Cloud Functions (Admin SDK) bypasses rules, so we BLOCK client writes.
      match /vouchers/{id} {
        allow read: if hasCompanyAccess(companyId);
        allow write: if false;
      }

      match /journal_entries/{id} {
        allow read: if hasCompanyAccess(companyId);
        allow write: if false;
      }

      match /stock_movements/{id} {
        allow read: if hasCompanyAccess(companyId);
        allow write: if false;
      }

      // Any other subcollections not explicitly matched
      match /{document=**} {
        allow read: if hasCompanyAccess(companyId);
        allow write: if false;
      }
    }
    
    // Fallback for global collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
