
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function getRole() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }
    function isAdmin() {
      return signedIn() && getRole() in ['Admin', 'CEO', 'Sales Manager', 'Accounts Manager', 'Accountant'];
    }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }

    // ---------- PUBLIC (Landing Page) ----------
    match /locations/{id} { allow read: if true; }
    match /jobOpenings/{id} { allow read: if true; }
    match /shopProducts/{id} { allow read: if true; }
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /posts/{id} { allow read: if true; allow write: if isAdmin(); }
    match /offers/{id} { allow read: if true; allow write: if isAdmin(); }
    match /company/{id} { allow read: if true; allow write: if isAdmin(); }
    match /pickupPoints/{id} { allow read: if true; }

    // ---------- USERS ----------
    match /users/{userId} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update, delete: if isOwner(userId) || isAdmin();

      match /notifications/{id} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if signedIn();
        allow update, delete: if isAdmin();
      }
      match /wallet/main { allow read, write: if isOwner(userId) || isAdmin(); }
      match /referrals/{id} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /registeredProducts/{id} { allow read: if isOwner(userId) || isAdmin(); }
      match /stock/{productId} { allow read: if isOwner(userId) || isAdmin(); }
    }

    // ---------- ORDERS ----------
    match /orders/{orderId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.assignedToUid == request.auth.uid
      );

      allow create: if signedIn() && (
        isAdmin() ||
        request.resource.data.userId == request.auth.uid
      );

      allow update: if signedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.assignedToUid == request.auth.uid
      );

      allow delete: if isAdmin();
    }

    // ---------- SALES INVOICES ----------
    match /salesInvoices/{invoiceId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.customerId == request.auth.uid ||
        resource.data.assignedToUid == request.auth.uid
      );
      allow create, update: if signedIn() && (isAdmin() || getRole() == 'Partner');
      allow delete: if isAdmin();
    }

    // ---------- LEADS ----------
    match /leads/{id} {
      allow read: if signedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid);
      allow create: if signedIn();
      allow update, delete: if signedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    // ---------- QUOTATIONS ----------
    match /quotations/{id} {
      allow read: if signedIn() && (isAdmin() || resource.data.createdBy == request.auth.uid);
      allow create: if signedIn();
      allow update, delete: if signedIn() && (isAdmin() || resource.data.createdBy == request.auth.uid);
    }

    // ---------- SERVICE ----------
    match /serviceRequests/{id} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.customer.id == request.auth.uid ||
        resource.data.assignedToUid == request.auth.uid
      );
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // ---------- ACCOUNTING ----------
    match /coa_ledgers/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /coa_groups/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /journalVouchers/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /parties/{id} { allow read: if signedIn(); allow write: if isAdmin(); }

    match /report_cache/{monthId} { allow read: if isAdmin(); allow write: if false; }
    match /fy_openings/{fyId} { allow read: if isAdmin(); allow write: if false; }

    // ---------- FINAL SAFETY NET ----------
    match /{path=**} {
      allow read, write: if isAdmin();
    }
  }
}
