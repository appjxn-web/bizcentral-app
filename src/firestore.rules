rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- 1. GLOBAL HELPERS ---
    function signedIn() { return request.auth != null; }
    function getRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() { return signedIn() && getRole() in ['Admin', 'CEO', 'Sales Manager', 'Accounts Manager', 'Accountant']; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }

    // --- 2. USERS & PROFILES ---
    match /users/{userId} {
      allow get: if signedIn(); 
      allow list: if isAdmin();
      allow write: if isOwner(userId) || isAdmin();
      
      match /notifications/{id} { 
        allow read: if isOwner(userId) || isAdmin();
        allow create: if signedIn(); 
        allow update, delete: if isAdmin();
      }
      match /wallet/main { allow read, write: if isOwner(userId) || isAdmin(); }
      match /referrals/{id} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /registeredProducts/{id} { allow read, list: if isOwner(userId) || isAdmin(); }
      match /stock/{productId} { allow read: if isOwner(userId); }
    }

    // --- 3. LOGISTICS (Orders & Invoices) ---
    match /orders/{orderId} {
      allow get: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid || resource.data.assignedToUid == request.auth.uid);
      allow list: if signedIn() && (isAdmin() || request.query.where.userId == request.auth.uid || request.query.where.assignedToUid == request.auth.uid);
      allow create: if signedIn();
      allow update: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid || resource.data.assignedToUid == request.auth.uid || request.resource.data.assignedToUid == request.auth.uid);
    }

    match /salesInvoices/{invoiceId} {
      allow get: if signedIn();
      allow list: if signedIn() && (isAdmin() || request.query.where.customerId == request.auth.uid || request.query.where.assignedToUid == request.auth.uid);
      allow create, update: if signedIn() && (isAdmin() || getRole() == 'Partner');
    }

    // --- 4. SALES & SERVICE ---
    match /leads/{id} {
      allow read, list: if signedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid);
      allow create: if signedIn();
      allow write: if signedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }
    
    match /quotations/{id} {
      allow get, list: if signedIn() && (isAdmin() || resource.data.createdBy == request.auth.uid);
      allow create: if signedIn();
      allow update: if signedIn() && (isAdmin() || resource.data.createdBy == request.auth.uid);
    }

    match /serviceRequests/{id} {
      allow read, list: if signedIn() && (isAdmin() || resource.data.customer.id == request.auth.uid || resource.data.assignedToUid == request.auth.uid);
      allow create: if signedIn();
      allow update: if isAdmin();
    }

    // --- 5. ACCOUNTING ---
    match /coa_ledgers/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /coa_groups/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /journalVouchers/{id} { allow read, list: if signedIn(); allow write: if isAdmin(); }
    match /parties/{id} { allow read: if signedIn(); allow write: if isAdmin(); }

    // --- 6. PUBLIC CONTENT & PAYMENTS ---
    match /products/{id} { allow read, list: if true; allow write: if isAdmin(); }
    match /posts/{id} { allow read, list: if true; allow write: if isAdmin(); }
    match /offers/{id} { allow read, list: if true; allow write: if isAdmin(); }
    match /company/{id} { allow read: if true; allow write: if isAdmin(); }
    
    match /paymentSubmissions/{id} {
      allow read, list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid || resource.data.assignedToUid == request.auth.uid);
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // --- FINAL GLOBAL SAFETY NET ---
    match /{path=**} {
      allow read, write: if isAdmin();
    }
  }
}
