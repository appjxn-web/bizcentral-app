
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- 1. GLOBAL HELPERS ---
    function signedIn() { return request.auth != null; }
    function getRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() { return signedIn() && getRole() in ['Admin', 'CEO', 'Sales Manager', 'Accounts Manager', 'Accountant']; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }

    // --- 2. USERS & PROFILES ---
    match /users/{userId} {
      allow get: if signedIn(); 
      allow list: if isAdmin();
      allow write: if isOwner(userId) || isAdmin();
      
      // FIXED: Allow create if signed in so Partners can send notifications to Customers
      match /notifications/{id} { 
        allow read: if isOwner(userId) || isAdmin();
        allow create: if signedIn(); 
        allow update, delete: if isAdmin();
      }
      match /wallet/main { allow read, write: if isOwner(userId) || isAdmin(); }
      match /referrals/{id} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /registeredProducts/{id} { allow read, list: if isOwner(userId) || isAdmin(); }
      match /stock/{productId} { allow read: if isOwner(userId); } // Allow partners to read their own stock
    }

    // --- 3. QUOTATIONS (Fixes current Partner error) ---
    match /quotations/{id} {
      allow get: if signedIn();
      // AUTHORIZATION: Authorize the data itself rather than the query parameters
      allow list: if signedIn() && (isAdmin() || resource.data.createdBy == request.auth.uid);
      allow create: if signedIn();
      allow update: if signedIn() && (isAdmin() || resource.data.createdBy == request.auth.uid);
    }

    // --- 4. GLOBAL ORDERS ---
    match /orders/{orderId} {
      allow get, list: if signedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid || 
        resource.data.assignedToUid == request.auth.uid
      );
      allow create: if signedIn();
      // PERMANENT FIX: Allow update if user is the Customer, the Assigned Partner, 
      // OR if a Partner is currently assigning themselves (claiming) the order.
      allow update: if signedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid || 
        resource.data.assignedToUid == request.auth.uid ||
        (getRole() == 'Partner' && request.resource.data.assignedToUid == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    // --- 5. SALES INVOICES ---
    match /salesInvoices/{invoiceId} {
        allow get, list: if signedIn() && (
          isAdmin() ||
          resource.data.customerId == request.auth.uid ||
          resource.data.assignedToUid == request.auth.uid
        );
        allow create, update: if signedIn() && (isAdmin() || request.resource.data.assignedToUid == request.auth.uid);
    }

    // --- 6. LEADS ---
    match /leads/{id} {
      allow read, list: if signedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid);
      allow create: if signedIn();
      allow write: if signedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    // --- 7. SERVICE & WARRANTY ---
    match /serviceRequests/{id} {
      allow read, list: if signedIn() && (isAdmin() || resource.data.customer.id == request.auth.uid || resource.data.assignedToUid == request.auth.uid);
      allow create: if signedIn();
      allow update: if isAdmin();
    }
    
    match /registeredProducts/{id} {
       allow read, list: if signedIn() && (isAdmin() || resource.data.customerId == request.auth.uid || resource.data.ownerId == request.auth.uid);
    }

    // --- 8. HR & REIMBURSEMENTS ---
    match /reimbursementRequests/{id} {
        allow read, list: if signedIn() && (isAdmin() || resource.data.createdByUid == request.auth.uid);
        allow create: if signedIn() && request.resource.data.createdByUid == request.auth.uid;
        allow update, delete: if isAdmin();
    }
    // NEW RULE FOR VACANCIES
    match /vacancies/{vacancyId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }


    // --- 9. ACCOUNTING ---
    match /coa_ledgers/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /coa_groups/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /journalVouchers/{id} { allow read, list: if signedIn(); allow write: if isAdmin(); }
    match /parties/{id} { allow read: if signedIn(); allow write: if isAdmin(); }

    // --- 10. PUBLIC CONTENT & PAYMENTS ---
    match /products/{id} { allow read, list: if true; allow write: if isAdmin(); }
    match /posts/{id} { allow read, list: if true; allow write: if isAdmin(); }
    match /offers/{id} { allow read, list: if true; allow write: if isAdmin(); }
    match /pickupPoints/{id} { allow read, list: if true; allow write: if isAdmin(); }
    match /locations/{id} { allow read, list: if true; allow write: if isAdmin(); }
    match /company/{id} { allow read: if true; allow write: if isAdmin(); }
    
    match /paymentSubmissions/{id} {
      allow read, list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid || resource.data.assignedToUid == request.auth.uid);
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // --- FINAL GLOBAL SAFETY NET ---
    match /{path=**} {
      allow read, write: if isAdmin();
    }
  }
}
