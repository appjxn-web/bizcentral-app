[debug] [2026-01-14T12:58:41.797Z] >>> [apiv2][query] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules [none]
[debug] [2026-01-14T12:58:41.800Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"\nrules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // --- Helper Functions ---\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function getUserData() {\n      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;\n    }\n\n    function isCompanyMember(companyId) {\n      return signedIn() && getUserData().companyMemberships.exists(c, c.companyId == companyId);\n    }\n\n    function getCompanyRole(companyId) {\n      return getUserData().companyMemberships.filter(c, c.companyId == companyId)[0].role;\n    }\n\n    function isAdmin(companyId) {\n      return isCompanyMember(companyId) && getCompanyRole(companyId) in ['Admin', 'CEO', 'Accounts Manager'];\n    }\n\n    function onlyChanges(allowed) {\n      return request.resource.data.diff(resource.data).changedKeys().hasOnly(allowed);\n    }\n\n    function isCreatingDraft() {\n      return request.resource.data.status == \"DRAFT\";\n    }\n\n    function isDraftDoc() {\n      return resource.data.status == \"DRAFT\";\n    }\n\n    // =========================\n    // PUBLIC-READABLE COLLECTIONS\n    // =========================\n    match /products/{productId} { allow read: if true; allow write: if isAdmin(\"default\"); }\n    match /vacancies/{vacancyId} { allow read: if true; allow write: if isAdmin(\"default\"); }\n    match /posts/{postId} { allow read: if true; allow write: if isAdmin(\"default\"); }\n    match /locations/{locationId} { allow read: if true; allow write: if isAdmin(\"default\"); }\n    match /pickupPoints/{pointId} { allow read: if true; allow write: if isAdmin(\"default\"); }\n    match /company/{docId} { allow read: if true; allow write: if isAdmin(\"default\"); }\n    match /offers/{offerId} { allow read: if true; allow write: if isAdmin(\"default\"); }\n\n\n    // =========================\n    // USERS\n    // =========================\n    match /users/{uid} {\n      allow read: if signedIn() && (request.auth.uid == uid || isAdmin(\"default\"));\n      allow write: if false; // prevent client editing roles/companies\n    }\n\n    // =========================\n    // COMPANY ROOT\n    // =========================\n    match /companies/{companyId} {\n      allow read: if isCompanyMember(companyId);\n      allow write: if isAdmin(companyId);\n\n      // ---- Settings (Finance defaults etc.) ----\n      match /settings/{docId} {\n        allow read: if isCompanyMember(companyId);\n        allow write: if isAdmin(companyId);\n      }\n\n      // ---- Masters ----\n      match /customers/{customerId} {\n        allow read: if isCompanyMember(companyId);\n        allow create, update: if isCompanyMember(companyId);\n        allow delete: if isAdmin(companyId);\n      }\n\n      match /products/{productId} {\n        allow read: if isCompanyMember(companyId);\n        allow write: if isAdmin(companyId);\n      }\n\n      match /warehouses/{warehouseId} {\n        allow read: if isCompanyMember(companyId);\n        allow write: if isAdmin(companyId);\n      }\n\n      match /coa_groups/{id} {\n        allow read: if isCompanyMember(companyId);\n        allow write: if isAdmin(companyId);\n      }\n\n      match /coa_ledgers/{id} {\n        allow read: if isCompanyMember(companyId);\n        allow write: if isAdmin(companyId);\n      }\n      \n      match /report_cache/{monthId} {\n        allow read: if isCompanyMember(companyId);\n        allow write: if false;\n      }\n      \n      match /fy_openings/{fyId} {\n        allow read: if isCompanyMember(companyId);\n        allow write: if false;\n      }\n      \n      match /audit_logs/{logId} {\n        allow read: if isAdmin(companyId);\n        allow write: if false;\n      }\n\n      // =========================\n      // SALES INVOICES (CLIENT DRAFT OK)\n      // =========================\n      match /sales_invoices/{invoiceId} {\n        allow read: if isCompanyMember(companyId);\n\n        allow create: if isCompanyMember(companyId)\n          && isCreatingDraft()\n          && request.resource.data.companyId == companyId\n          && request.resource.data.createdBy == request.auth.uid;\n\n        allow update: if isCompanyMember(companyId)\n          && isDraftDoc()\n          && resource.data.createdBy == request.auth.uid\n          && onlyChanges([\n              \"invoiceDate\", \"invoiceNo\", \"customerId\", \"warehouseId\",\n              \"items\", \"discount\", \"shipping\", \"note\",\n              \"updatedAt\", \"updatedBy\",\n              \"status\"\n          ])\n          && request.resource.data.status == \"DRAFT\";\n\n        allow delete: if isCompanyMember(companyId)\n          && isDraftDoc()\n          && (resource.data.createdBy == request.auth.uid || isAdmin(companyId));\n      }\n\n      // =========================\n      // SERVER-ONLY LEDGERS (POSTING OUTPUT)\n      // =========================\n      match /vouchers/{id} {\n        allow read: if isCompanyMember(companyId);\n        allow write: if false;\n      }\n\n      match /journal_entries/{id} {\n        allow read: if isCompanyMember(companyId);\n        allow write: if false;\n      }\n\n      match /stock_movements/{id} {\n        allow read: if isCompanyMember(companyId);\n        allow write: if false;\n      }\n\n      // Any other subcollections not explicitly matched\n      match /{document=**} {\n        allow read: if isCompanyMember(companyId);\n        allow write: if false;\n      }\n    }\n    \n    // Fallback for global collections\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n"}]}}
