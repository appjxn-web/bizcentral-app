[debug] [2026-01-14T15:55:30.618Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"\nrules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    function signedIn() { return request.auth != null; }\n    function getRole() {\n      return signedIn()\n        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role\n        : null;\n    }\n    function isAdmin() {\n      return signedIn() && getRole() in ['Admin', 'CEO', 'Sales Manager', 'Accounts Manager', 'Accountant'];\n    }\n    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }\n\n    // ---------- PUBLIC (Landing Page) ----------\n    match /locations/{id} { allow read: if true; }\n    match /jobOpenings/{id} { allow read: if true; }\n    match /shopProducts/{id} { allow read: if true; }\n    match /products/{id} { allow read: if true; allow write: if isAdmin(); }\n    match /posts/{id} { allow read: if true; allow write: if isAdmin(); }\n    match /offers/{id} { allow read: if true; allow write: if isAdmin(); }\n    match /company/{id} { allow read: if true; allow write: if isAdmin(); }\n    match /pickupPoints/{id} { allow read: if true; }\n\n    // ---------- USERS ----------\n    match /users/{userId} {\n      allow get: if signedIn();\n      allow list: if isAdmin();\n      allow create: if signedIn() && request.auth.uid == userId;\n      allow update, delete: if isOwner(userId) || isAdmin();\n\n      match /notifications/{id} {\n        allow read: if isOwner(userId) || isAdmin();\n        allow create: if signedIn();\n        allow update, delete: if isAdmin();\n      }\n      match /wallet/main { allow read, write: if isOwner(userId) || isAdmin(); }\n      match /referrals/{id} { allow read, write: if isOwner(userId) || isAdmin(); }\n      match /registeredProducts/{id} { allow read: if isOwner(userId) || isAdmin(); }\n      match /stock/{productId} { allow read: if isOwner(userId) || isAdmin(); }\n    }\n\n    // ---------- ORDERS ----------\n    match /orders/{orderId} {\n      allow read: if signedIn() && (\n        isAdmin() ||\n        resource.data.userId == request.auth.uid ||\n        resource.data.assignedToUid == request.auth.uid\n      );\n\n      allow create: if signedIn() && (\n        isAdmin() ||\n        request.resource.data.userId == request.auth.uid\n      );\n\n      allow update: if signedIn() && (\n        isAdmin() ||\n        resource.data.userId == request.auth.uid ||\n        resource.data.assignedToUid == request.auth.uid\n      );\n\n      allow delete: if isAdmin();\n    }\n\n    // ---------- SALES INVOICES ----------\n    match /salesInvoices/{invoiceId} {\n      allow read: if signedIn() && (\n        isAdmin() ||\n        resource.data.customerId == request.auth.uid ||\n        resource.data.assignedToUid == request.auth.uid\n      );\n      allow create, update: if signedIn() && (isAdmin() || getRole() == 'Partner');\n      allow delete: if isAdmin();\n    }\n\n    // ---------- LEADS ----------\n    match /leads/{id} {\n      allow read: if signedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid);\n      allow create: if signedIn();\n      allow update, delete: if signedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid);\n    }\n\n    // ---------- QUOTATIONS ----------\n    match /quotations/{id} {\n      allow read: if signedIn() && (isAdmin() || resource.data.createdBy == request.auth.uid);\n      allow create: if signedIn();\n      allow update, delete: if signedIn() && (isAdmin() || resource.data.createdBy == request.auth.uid);\n    }\n\n    // ---------- SERVICE ----------\n    match /serviceRequests/{id} {\n      allow read: if signedIn() && (\n        isAdmin() ||\n        resource.data.customer.id == request.auth.uid ||\n        resource.data.assignedToUid == request.auth.uid\n      );\n      allow create: if signedIn();\n      allow update, delete: if isAdmin();\n    }\n\n    // ---------- ACCOUNTING ----------\n    match /coa_ledgers/{id} { allow read: if signedIn(); allow write: if isAdmin(); }\n    match /coa_groups/{id} { allow read: if signedIn(); allow write: if isAdmin(); }\n    match /journalVouchers/{id} { allow read: if signedIn(); allow write: if isAdmin(); }\n    match /parties/{id} { allow read: if signedIn(); allow write: if isAdmin(); }\n\n    match /report_cache/{monthId} { allow read: if isAdmin(); allow write: if false; }\n    match /fy_openings/{fyId} { allow read: if isAdmin(); allow write: if false; }\n\n    // ---------- FINAL SAFETY NET ----------\n    match /{path=**} {\n      allow read, write: if isAdmin();\n    }\n  }\n}\n"}]}}
