[debug] [2026-01-14T19:17:45.035Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"\nrules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // --- 1. GLOBAL HELPERS ---\n    function signedIn() { return request.auth != null; }\n    function getRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }\n    function isAdmin() { return signedIn() && getRole() in ['Admin', 'CEO', 'Sales Manager', 'Accounts Manager', 'Accountant']; }\n    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }\n\n    // --- 2. USERS & PROFILES ---\n    match /users/{userId} {\n      allow get: if signedIn(); \n      allow list: if isAdmin();\n      allow write: if isOwner(userId) || isAdmin();\n      \n      match /notifications/{id} { \n        allow read: if isOwner(userId) || isAdmin();\n        allow create: if signedIn(); \n        allow update, delete: if isAdmin();\n      }\n      match /wallet/main { allow read, write: if isOwner(userId) || isAdmin(); }\n      match /referrals/{id} { allow read, write: if isOwner(userId) || isAdmin(); }\n      match /registeredProducts/{id} { allow read, list: if isOwner(userId) || isAdmin(); }\n      match /stock/{productId} { allow read: if isOwner(userId); }\n    }\n\n    // --- 3. LOGISTICS (Orders & Invoices) ---\n    match /orders/{orderId} {\n      allow get: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid || resource.data.assignedToUid == request.auth.uid);\n      allow list: if signedIn() && (isAdmin() || request.query.where.userId == request.auth.uid || request.query.where.assignedToUid == request.auth.uid);\n      allow create: if signedIn();\n      allow update: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid || resource.data.assignedToUid == request.auth.uid || request.resource.data.assignedToUid == request.auth.uid);\n    }\n\n    match /salesInvoices/{invoiceId} {\n      allow get: if signedIn();\n      allow list: if signedIn() && (isAdmin() || request.query.where.customerId == request.auth.uid || request.query.where.assignedToUid == request.auth.uid);\n      allow create, update: if signedIn() && (isAdmin() || getRole() == 'Partner');\n    }\n\n    // --- 4. SALES & SERVICE ---\n    match /leads/{id} {\n      allow read, list: if signedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid);\n      allow create: if signedIn();\n      allow write: if signedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid);\n    }\n    \n    match /quotations/{id} {\n      allow get, list: if signedIn() && (isAdmin() || resource.data.createdBy == request.auth.uid);\n      allow create: if signedIn();\n      allow update: if signedIn() && (isAdmin() || resource.data.createdBy == request.auth.uid);\n    }\n\n    match /serviceRequests/{id} {\n      allow read, list: if signedIn() && (isAdmin() || resource.data.customer.id == request.auth.uid || resource.data.assignedToUid == request.auth.uid);\n      allow create: if signedIn();\n      allow update: if isAdmin();\n    }\n\n    // --- 5. ACCOUNTING ---\n    match /coa_ledgers/{id} { allow read: if signedIn(); allow write: if isAdmin(); }\n    match /coa_groups/{id} { allow read: if signedIn(); allow write: if isAdmin(); }\n    match /journalVouchers/{id} { allow read, list: if signedIn(); allow write: if isAdmin(); }\n    match /parties/{id} { allow read: if signedIn(); allow write: if isAdmin(); }\n\n    // --- 6. PUBLIC CONTENT & PAYMENTS ---\n    match /products/{id} { allow read, list: if true; allow write: if isAdmin(); }\n    match /posts/{id} { allow read, list: if true; allow write: if isAdmin(); }\n    \n    // CORRECTED RULE: Allow any signed-in user to list offers.\n    // The application logic handles filtering which offers are shown to which role.\n    match /offers/{offerId} { \n        allow read, list: if signedIn(); \n        allow write: if isAdmin(); \n    }\n\n    match /company/{id} { allow read: if true; allow write: if isAdmin(); }\n    \n    match /paymentSubmissions/{id} {\n      allow read, list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid || resource.data.assignedToUid == request.auth.uid);\n      allow create: if signedIn();\n      allow update, delete: if isAdmin();\n    }\n\n    // --- FINAL GLOBAL SAFETY NET ---\n    match /{path=**} {\n      allow read, write: if isAdmin();\n    }\n  }\n}\n"}]}}
